{
  "manifestVersion": 5,
  "id": "com.kiochan.colorpicker",
  "name": "Kio Color Picker",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "pickerPanel",
      "label": {
        "default": "Kio Color Picker"
      },
      "minimumSize": {
        "width": 205,
        "height": 290
      },
      "preferredDockedSize": {
        "width": 310,
        "height": 455
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 480
      },
      "maximumSize": {
        "width": 2200,
        "height": 2200
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
