{
  "name": "kio-color-picker-photoshop",
  "version": "0.3.1",
  "private": true,
  "description": "Lightweight Photoshop UXP color picker",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node tests/run.js && node tests/release.js && node tests/package-ccx.js",
    "check": "npm run typecheck && npm run lint && node scripts/check.js",
    "stage": "npm run build && node scripts/stage.js && node tests/stage.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@adobe/cc-ext-uxp-types": "7.3.1",
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/photoshop": "27.11.0",
    "typescript": "7.0.2"
  }
}
